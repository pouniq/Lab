x <- c(1,0.5,01)
sig <- matrix(c(9,0,-1,0,7,2,-1,2,5),nrow=3)
sig
f <- function(x,mu,sig){
1 / (sqrt((2*pi)^3 * det(sig))) * exp(-0.5 * t((x - mu)) * inv(sig) * (x-mu))
}
f <- function(x,mu,sig){
1 / (sqrt((2*pi)^3 * det(sig))) * exp(-0.5 * t((x - mu)) * solve(sig) * (x-mu))
}
f(x,mu,sig)
