gammalik <- function(theta, x){
alpha <- theta[1]
beta <- theta[2]
z <- (1/gamma(alpha)*beta^alpha)*x^(alpha - 1)*exp(-x/beta)
y<- ifelse(x >= 0, z, 0)
prod(y)
}
gammalik(3,4)
gammalik(c(3,1),x)
